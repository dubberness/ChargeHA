# ChargeHA Environment Variables
# All other configuration (Tesla, Fronius, etc.) is managed via the Settings UI or Setup Wizard.

PORT=8000
DB_PATH=./data/chargeha.db

# Log verbosity: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Required for encrypting secrets stored in the database (Tesla credentials, Fronius passwords, etc.)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: lets a LAN dashboard make a few allowlisted reads without logging in
# (Authorization: Bearer <key>). At least 32 characters. Generate with: openssl rand -hex 32
# READONLY_API_KEY=

# Optional: web page origins (comma-separated, exact) allowed to make those reads from the browser,
# e.g. a wall panel served by Home Assistant: http://192.168.1.133
# READONLY_CORS_ORIGINS=
